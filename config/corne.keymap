#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESC>;
            key-positions = <19 20>;
            timeout-ms = <100>;
            layers = <0>;
        };
    };

    behaviors {
        bspc_or_del: bspc_or_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_OR_DEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shift_or_caps: shift_or_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_OR_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&kp CAPS>;

            tapping-term-ms = <200>;
        };

        next_or_prev: next_or_prev {
            compatible = "zmk,behavior-mod-morph";
            label = "NEXT_OR_PREV";
            bindings = <&kp C_NEXT>, <&kp C_PREV>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB   &kp Q        &kp W           &kp E           &kp R         &lt 3 T      &kp Y    &kp U         &kp I            &kp O            &kp P      &bspc_or_del
&kp CAPS  &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LSHIFT F  &kp G        &kp H    &mt RSHIFT J  &mt RIGHT_GUI K  &mt RIGHT_ALT L  &kp RCTRL  &kp ESC
&trans    &kp Z        &kp X           &kp C           &kp V         &kp B        &kp N    &kp M         &trans           &trans           &trans     &kp GLOBE
                                       &mo 2           &mo 1         &kp SPACE    &kp RET  &mo 2         &mo 1
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Nums";
            bindings = <
&kp F1      &kp F2              &kp F3                 &kp F4                 &kp F5               &kp F6          &kp F7        &kp F8               &kp F9                  &kp F10                 &kp F11             &kp F12
&trans      &mt LCTRL NUMBER_1  &mt LEFT_ALT NUMBER_2  &mt LEFT_GUI NUMBER_3  &mt LSHIFT NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &mt RSHIFT NUMBER_7  &mt RIGHT_GUI NUMBER_8  &mt RIGHT_ALT NUMBER_9  &mt RCTRL NUMBER_0  &trans
&bt BT_CLR  &bt BT_SEL 0        &bt BT_SEL 1           &bt BT_SEL 2           &bt BT_SEL 3         &bt BT_SEL 4    &trans        &kp C_MUTE           &kp C_VOL_DN            &kp C_VOL_UP            &kp C_PP            &trans
                                                       &trans                 &trans               &trans          &trans        &trans               &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Symbols";
            bindings = <
&trans  &kp DLLR         &kp EXCL           &kp LPAR                   &kp RPAR                  &kp PRCNT    &kp CARET  &kp AMPS       &kp HASH                 &kp STAR           &kp AT           &trans
&trans  &mt LCTRL GRAVE  &mt LEFT_ALT PIPE  &mt LEFT_GUI LEFT_BRACKET  &mt LSHIFT RIGHT_BRACKET  &kp EQUAL    &kp LT     &mt RSHIFT GT  &mt RIGHT_GUI SEMICOLON  &mt RIGHT_ALT SQT  &mt RCTRL SLASH  &trans
&trans  &kp TILDE        &kp BACKSLASH      &kp LBRC                   &kp RBRC                  &kp PLUS     &kp COMMA  &kp PERIOD     &kp COLON                &kp DQT            &kp QMARK        &trans
                                            &trans                     &trans                    &kp MINUS    &trans     &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
                        &trans  &trans  &trans    &trans    &trans    &trans
            >;

            label = "Nav";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
